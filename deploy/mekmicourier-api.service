[Unit]
Description=MekMiCourier API
After=network.target

[Service]
WorkingDirectory=/opt/mekmicourier-api
ExecStart=/usr/bin/dotnet /opt/mekmicourier-api/WarehouseApi.dll --urls http://127.0.0.1:5265
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=mekmicourier-api
User=root
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=true

[Install]
WantedBy=multi-user.target
